Subject: [PATCH] GETBULK: return a truncated response per RFC 3416 4.2.3 instead of tooBig

--- a/src/SNMPZeroCopy.cpp
+++ b/src/SNMPZeroCopy.cpp
@@ -246,7 +246,12 @@
     }
 
     /* Repeaters walk from the request OID, then from each selected handler
-     * OID.  The cursor is always staged data, never a request-buffer slice. */
+     * OID.  The cursor is always staged data, never a request-buffer slice.
+     *
+     * LOCAL ESP8266_SNMP PATCH (RFC 3416 4.2.3): when the plan is full,
+     * STOP adding and return what fits — truncated response, not tooBig.
+     * Upstream returned stageGetBulk=false -> tooBig when NMS bulkwalks
+     * with max-repetitions > SNMP_MAX_VARBINDS. */
     for(unsigned int i = nonRepeaterCount;
         i < (unsigned int)request.varbindCount; i++){
         OidWire cursor;
@@ -256,6 +261,9 @@
         int foundAt = 0;
 
         for(unsigned int repetition = 0; repetition < maxRepetitions; repetition++){
+            if(plan.count >= SNMP_MAX_VARBINDS){
+                break;   /* plan full: normal truncation per RFC 3416 */
+            }
             ValueCallback* callback = ValueCallback::findCallbackForSlice(
                 callbacks, callbacksCount, cursor.bytes + 2, (int)cursor.len - 2,
                 true, foundAt, &foundAt);
